# geometry_kube - show the current kubectl context/namespace, and optionally client version.

emulate -L zsh

: ${GEOMETRY_KUBE_COLOR:=blue}
: ${GEOMETRY_KUBE_SYMBOL:=⎈}
: ${GEOMETRY_KUBE_SEPARATOR:=|}
: ${GEOMETRY_KUBE_VERSION:=true}
: ${GEOMETRY_KUBE_PIN:=false}
: ${GEOMETRY_KUBE_CONTEXT_COLOR:=default}
: ${GEOMETRY_KUBE_NAMESPACE_COLOR:=default}
: ${GEOMETRY_KUBE_VERSION_COLOR:=default}

geometry::kube::version() {
  # Resolved once per shell by geometry::kube::resolve; see the note there on
  # why `--short` is gone and why stderr must be discarded.
  [[ -n "$GEOMETRY[kube_version]" ]] || return
  ansi $GEOMETRY_KUBE_VERSION_COLOR "$GEOMETRY[kube_version]"
}

(( $+commands[kubectl] )) || return

# Populated by the geometry::kube::resolve precmd hook in the parent shell, so
# the usual case costs no fork at all. Calling it here covers the very first
# render and non-interactive use; it is a no-op once the hook has run.
geometry::kube::resolve

local ctx="${GEOMETRY[kube_context]}"
local ns="${GEOMETRY[kube_namespace]}"

[[ $GEOMETRY_KUBE_PIN == true ]] || [[ -n "$KUBECONFIG" ]] || [[ -n "$ctx" ]] || return

: ${ctx:=none}
: ${ns:=default}

# The prompt is subject to prompt expansion, so a literal % must be doubled or
# a context named e.g. gke_p%d_... renders as a prompt escape.
ctx="${ctx//\%/%%}"
ns="${ns//\%/%%}"

# `ansi` accepts exactly two arguments and silently prints nothing otherwise,
# so quote unconditionally. Sequential calls concatenate straight onto stdout,
# which avoids a command substitution per field.
ansi $GEOMETRY_KUBE_COLOR "$GEOMETRY_KUBE_SYMBOL"
builtin print -rn -- " "
ansi $GEOMETRY_KUBE_CONTEXT_COLOR "$ctx"
builtin print -rn -- "$GEOMETRY_KUBE_SEPARATOR"
ansi $GEOMETRY_KUBE_NAMESPACE_COLOR "$ns"

if [[ $GEOMETRY_KUBE_VERSION == true && -n "$GEOMETRY[kube_version]" ]]; then
  builtin print -rn -- "$GEOMETRY_KUBE_SEPARATOR"
  geometry::kube::version
fi

# geometry::wrap discards a segment whose exit status is non-zero, so the
# status of the last conditional above must not leak out.
return 0
